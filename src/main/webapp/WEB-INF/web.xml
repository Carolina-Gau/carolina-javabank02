<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <!--defines the servlet-->
    <servlet>
        <!--defines the name of the servlet-->
        <servlet-name>ListController</servlet-name>
        <!--specifies the path to the servlet class-->
        <servlet-class>com.codeforall.online.javabank.controllers.ListController</servlet-class>
    </servlet>

    <!--maps the servlet to a URL-->
    <servlet-mapping>
        <!--specifies the name of the servlet-->
        <servlet-name>ListController</servlet-name>
        <!--the string in this tag defines
        the path that will be added to the URL-->
        <url-pattern>/</url-pattern> <!-- htpp://localhost:8080/cpfovideostore/ -->
    </servlet-mapping>

    <servlet>
        <servlet-name>CustomerDetailsController</servlet-name>
        <servlet-class>com.codeforall.online.javabank.controllers.CustomerDetailsController</servlet-class>
    </servlet>
    
    <servlet-mapping>
        <servlet-name>CustomerDetailsController</servlet-name>
        <url-pattern>details</url-pattern>
    </servlet-mapping>
</web-app>